# Copy to .env and fill in. Loaded by both the Makefile and the batch driver.
# The file doubles as make syntax: keep values unquoted and free of `$`.

# R2 bucket the region packs upload to.
BUCKET=mapos-regions

# rclone R2 remote (auto-configured from these — no rclone.conf needed).
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=

# Optional. Built-artifact root — point at an external drive for world-scale
# builds. The directory must already exist.
# DIST_DIR=/Volumes/T7/mapos-dist

# Optional. Where `make bundle-world` drops the low-zoom world basemap.
# Defaults to ../mapos/apps/dashboard/resources/basemap-assets.
# DASHBOARD_ASSETS=../mapos/apps/dashboard/resources/basemap-assets
